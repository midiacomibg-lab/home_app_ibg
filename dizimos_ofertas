<!DOCTYPE html> 
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IBG - Dashboard Dinâmico</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Figtree -->
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ibg: {
                            blue: '#0B1B3D',
                            darkBlue: '#061026',
                            brightBlue: '#1E60D5',
                            cyan: '#00F0FF',
                            orange: '#f97316',
                            yellow: '#eab308',
                            green: '#22c55e'
                        }
                    },
                    fontFamily: {
                        sans: ['Figtree', 'sans-serif'],
                        figtree: ['Figtree', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #061024;
            font-family: 'Figtree', sans-serif;
            overflow-x: hidden;
            letter-spacing: 0.04em;
        }

        .circuit-bg {
            background: radial-gradient(circle at 75% 30%, #154bb3 0%, #0a2561 45%, #050d21 85%);
        }

        .ibg-box {
            background: rgba(14, 28, 64, 0.82);
            backdrop-filter: blur(14px);
            border: 2px solid #00f0ff;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.25), inset 0 0 15px rgba(0, 240, 255, 0.1);
            transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
        }

        .animate-box-entry {
            animation: boxSuspenseEntry 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes boxSuspenseEntry {
            0% {
                opacity: 0;
                transform: translateY(28px) scale(0.94);
                filter: blur(8px);
                box-shadow: 0 0 0px rgba(0, 240, 255, 0);
            }
            50% {
                opacity: 0.7;
                filter: blur(2px);
                box-shadow: 0 0 40px rgba(0, 240, 255, 0.5);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0px);
                box-shadow: 0 0 25px rgba(0, 240, 255, 0.25);
            }
        }

        .ibg-glow-text {
            text-shadow: 0 0 14px rgba(0, 240, 255, 0.7);
        }

        .progress-ring__circle {
            transition: stroke-dashoffset 1.2s cubic-bezier(0.4, 0, 0.2, 1), stroke 0.8s ease;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        .linear-progress-fill {
            transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(90deg, #00c6ff 0%, #00f0ff 100%);
            box-shadow: 0 0 12px #00f0ff;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(10, 25, 65, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: #00f0ff;
            border-radius: 3px;
        }

        /* Botão de Tela Cheia */
        .fullscreen-btn {
            position: fixed;
            bottom: 15px;
            right: 15px;
            z-index: 100;
            background: rgba(31, 41, 55, 0.8);
            color: #f59e0b;
            border: 1px solid #374151;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: background 0.3s;
        }

        .fullscreen-btn:hover {
            background: #374151;
        }

        /* Ajuste de escala fluida para projetores e monitores gigantes */
        @media (min-width: 1600px) {
            html {
                font-size: 18px;
            }
        }
        @media (min-width: 2000px) {
            html {
                font-size: 22px;
            }
        }
    </style>
</head>
<body class="min-h-screen text-white relative circuit-bg flex flex-col justify-between p-4 md:p-8 select-none font-sans">

  <button class="fullscreen-btn" onclick="toggleFullScreen()">⛶</button>

    <!-- Tech Canvas for Animated Nodes & Lines Background -->
