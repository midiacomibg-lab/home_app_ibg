<!-- JAVASCRIPT LOGIC -->
    <script>
        const monthNames = [
            "JANEIRO", "FEVEREIRO", "MARÇO", "ABRIL", "MAIO", "JUNHO",
            "JULHO", "AGOSTO", "SETEMBRO", "OUTUBRO", "NOVEMBRO", "DEZEMBRO"
        ];

        const DEFAULT_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbykKFgLG-kv5MSQaE_O7t6vkeTJMvQSBma6uxdFjhJ_M9qmTa1z7DJFsF40Gwkrzj-8/exec";

        // Cache local: guarda o último dado válido recebido do Apps Script.
        // A tela usa esse dado imediatamente e atualiza em segundo plano.
        let historyRecords = [];
        const LOCAL_CACHE_KEY = "ibg_dizimos_ofertas_cache_v1";
        const LOCAL_CACHE_MAX_AGE = 7 * 24 * 60 * 60 * 1000; // 7 dias

        function loadLocalCache() {
            try {
                const raw = localStorage.getItem(LOCAL_CACHE_KEY);
                if (!raw) return null;
                const cached = JSON.parse(raw);
                if (!cached || !Array.isArray(cached.records) || !cached.records.length) return null;
                if (Date.now() - Number(cached.savedAt || 0) > LOCAL_CACHE_MAX_AGE) return null;
                return cached;
            } catch (e) {
                console.warn("Não foi possível ler o cache local:", e);
                return null;
            }
        }

        function saveLocalCache(records) {
            try {
                localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify({
                    savedAt: Date.now(),
                    records
                }));
            } catch (e) {
                console.warn("Não foi possível salvar o cache local:", e);
            }
        }

        function formatCacheAge(savedAt) {
            if (!savedAt) return "";
            const seconds = Math.max(0, Math.floor((Date.now() - savedAt) / 1000));
            if (seconds < 60) return "agora mesmo";
            if (seconds < 3600) return `há ${Math.floor(seconds / 60)} min`;
            if (seconds < 86400) return `há ${Math.floor(seconds / 3600)} h`;
            return `há ${Math.floor(seconds / 86400)} dia(s)`;
        }

        function applyRecords(records, sourceLabel, animate = false) {
            if (!records || !records.length) return false;
            historyRecords = records;

            // Usa o registro mais recente como valor exibido no painel.
            const latest = [...records].sort((a, b) =>
                (b.month * 31 + b.day) - (a.month * 31 + a.day)
            )[0];

            if (latest) {
                state.day = latest.day;
                state.month = latest.month;
                state.percentage = latest.percentage;
                updateDashboardUI(animate);
            }

            document.getElementById('sheetSourceLabel').textContent = sourceLabel;
            renderHistoryModal();
            return true;
        }

        function showCachedDataIfAvailable() {
            const cached = loadLocalCache();
            if (!cached) return false;

            if (applyRecords(
                cached.records,
                `Fonte: Cache local (${formatCacheAge(cached.savedAt)})`,
                false
            )) {
                syncStatusText.textContent = "Último dado salvo";
                syncDot.className = "w-2.5 h-2.5 rounded-full bg-cyan-400";
                return true;
            }
            return false;
        }

        // Estado do Dashboard
        let state = {
            day: 18,
            month: 9, 
            percentage: 0,
            scriptUrl: DEFAULT_APPS_SCRIPT_URL
        };

        // Elementos DOM
        const leftBox = document.getElementById('leftBox');
        const rightBox = document.getElementById('rightBox');
        const monthDisplay = document.getElementById('monthDisplay');
        const dateDisplay = document.getElementById('dateDisplay');
        const dayRatioText = document.getElementById('dayRatioText');
        const linearBarFill = document.getElementById('linearBarFill');
        const monthEndLabel = document.getElementById('monthEndLabel');
        const percentageDisplay = document.getElementById('percentageDisplay');
        const circleProgress = document.getElementById('circleProgress');
        const gaugeStatusText = document.getElementById('gaugeStatusText');
        const syncStatusText = document.getElementById('syncStatusText');
        const syncBadge = document.getElementById('syncBadge');
        const syncDot = document.getElementById('syncDot');

        // Modais e Controles
        const configModal = document.getElementById('configModal');
        const historyModal = document.getElementById('historyModal');
        const historyList = document.getElementById('historyList');
        const openConfigBtn = document.getElementById('openConfigBtn');
        const closeConfigBtn = document.getElementById('closeConfigBtn');
        const openHistoryBtn = document.getElementById('openHistoryBtn');
        const closeHistoryBtn = document.getElementById('closeHistoryBtn');
        const closeHistoryBottomBtn = document.getElementById('closeHistoryBottomBtn');

        const tabScriptBtn = document.getElementById('tabScriptBtn');
        const tabManualBtn = document.getElementById('tabManualBtn');
        const tabScriptContent = document.getElementById('tabScriptContent');
        const tabManualContent = document.getElementById('tabManualContent');
        const scriptUrlInput = document.getElementById('scriptUrlInput');
        const fetchScriptBtn = document.getElementById('fetchScriptBtn');
        const manualDayInput = document.getElementById('manualDayInput');
        const manualMonthSelect = document.getElementById('manualMonthSelect');
        const manualPercentInput = document.getElementById('manualPercentInput');
        const manualSliderVal = document.getElementById('manualSliderVal');
        const applyManualBtn = document.getElementById('applyManualBtn');

        function getDaysInMonth(month, year = new Date().getFullYear()) {
            return new Date(year, month, 0).getDate();
        }

        function formatDateString(day, month) {
            const d = String(day).padStart(2, '0');
            const m = String(month).padStart(2, '0');
            return `${d}/${m}`;
        }

        function triggerCardAnimations() {
            leftBox.classList.remove('animate-box-entry');
            rightBox.classList.remove('animate-box-entry');
            
            void leftBox.offsetWidth;
            void rightBox.offsetWidth;

            leftBox.classList.add('animate-box-entry');
            rightBox.classList.add('animate-box-entry');
        }

        function updateDashboardUI(animate = true) {
            const currentYear = new Date().getFullYear();
            const totalDays = getDaysInMonth(state.month, currentYear);
            const validDay = Math.min(Math.max(1, state.day), totalDays);
            
            const monthName = monthNames[state.month - 1] || "MÊS";
            monthDisplay.textContent = monthName;
            dateDisplay.textContent = formatDateString(validDay, state.month);

            const dayPercentage = Math.min(100, Math.max(0, (validDay / totalDays) * 100));
            dayRatioText.textContent = `${validDay} / ${totalDays} Dias`;
            monthEndLabel.textContent = `Dia ${totalDays}`;
            linearBarFill.style.width = `${dayPercentage}%`;

            const formattedPercentage = Number(state.percentage).toLocaleString('pt-BR', {
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
            });
            percentageDisplay.textContent = `${formattedPercentage}%`;

            const radius = 48;
            const circumference = 2 * Math.PI * radius;
            
            const visualPercent = Math.min(100, Math.max(0, state.percentage));
            const strokeDashoffset = circumference - (visualPercent / 100) * circumference;
            circleProgress.style.strokeDashoffset = strokeDashoffset;

            if (state.percentage < 40) {
                circleProgress.setAttribute('stroke', 'url(#gaugeGradientOrange)');
                gaugeStatusText.textContent = "Prossigamos com fé!";
                gaugeStatusText.className = "text-xs text-orange-400 uppercase tracking-widest font-bold mt-2";
            } else if (state.percentage < 75) {
                circleProgress.setAttribute('stroke', 'url(#gaugeGradientYellow)');
                gaugeStatusText.textContent = "Em Progresso";
                gaugeStatusText.className = "text-xs text-yellow-400 uppercase tracking-widest font-bold mt-2";
            } else if (state.percentage >= 100) {
                circleProgress.setAttribute('stroke', 'url(#gaugeGradientGreen)');
                gaugeStatusText.textContent = "Deus é Fiel! 🎉";
                gaugeStatusText.className = "text-xs text-emerald-400 uppercase tracking-widest font-bold mt-2";
            } else {
                circleProgress.setAttribute('stroke', 'url(#gaugeGradientGreen)');
                gaugeStatusText.textContent = "Meta Próxima";
                gaugeStatusText.className = "text-xs text-emerald-400 uppercase tracking-widest font-bold mt-2";
            }

            if (animate) {
                triggerCardAnimations();
            }
        }

        function renderHistoryModal() {
            historyList.innerHTML = "";
            
            if (!historyRecords || historyRecords.length === 0) {
                historyList.innerHTML = `<div class="text-center text-slate-400 py-6 text-xs">Nenhum registro encontrado.</div>`;
                return;
            }

            const sorted = [...historyRecords].sort((a, b) => (a.month * 31 + a.day) - (b.month * 31 + b.day));

            sorted.forEach(rec => {
                const isActive = (rec.day === state.day && rec.month === state.month);
                const card = document.createElement('div');
                card.className = `p-3 rounded-xl border flex justify-between items-center cursor-pointer transition ${
                    isActive 
                    ? 'bg-ibg-blue border-ibg-cyan shadow-md shadow-ibg-cyan/20' 
                    : 'bg-slate-900/60 border-slate-800 hover:border-slate-600 hover:bg-slate-900'
                }`;

                let colorClass = "text-orange-400";
                if (rec.percentage >= 75) colorClass = "text-emerald-400";
                else if (rec.percentage >= 40) colorClass = "text-yellow-400";

                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-slate-950/80 flex items-center justify-center text-ibg-cyan text-xs font-bold">
                            ${String(rec.day).padStart(2,'0')}
                        </div>
                        <div>
                            <div class="text-xs font-bold text-white tracking-wider">${monthNames[rec.month - 1] || 'MÊS'}</div>
                            <div class="text-[11px] text-slate-400">Data: ${formatDateString(rec.day, rec.month)}</div>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-sm font-extrabold ${colorClass} tracking-wider">${rec.percentage.toLocaleString('pt-BR')}%</span>
                        <span class="block text-[10px] text-slate-400 uppercase font-semibold">Atingimento</span>
                    </div>
                `;

                // CLIQUE NO ITEM DO HISTÓRICO: Atualiza a tela e fecha a modal
                card.addEventListener('click', () => {
                    state.day = rec.day;
                    state.month = rec.month;
                    state.percentage = rec.percentage;
                    
                    updateDashboardUI(true);
                    
                    // Oculta a modal de histórico
                    historyModal.classList.add('opacity-0', 'pointer-events-none');
                });

                historyList.appendChild(card);
            });
        }

        function processAppsScriptData(jsonData) {
            try {
                let items = [];

                if (Array.isArray(jsonData)) {
                    jsonData.forEach((row, idx) => {
                        if (Array.isArray(row)) {
                            if (idx === 0 && (typeof row[0] === 'string' && isNaN(Number(row[0])))) return;
                            if (row.length >= 2) {
                                let d = parseInt(row[0], 10) || 1;
                                let m = row.length >= 3 ? parseInt(row[1], 10) : state.month;
                                let pVal = row[row.length - 1];
                                let p = parseFloat(String(pVal).replace('%', '').replace(',', '.')) || 0;
                                items.push({ day: d, month: m, percentage: p });
                            }
                        } else if (typeof row === 'object' && row !== null) {
                            let d = parseInt(row.dia || row.day || row.Dia || 1, 10);
                            let m = parseInt(row.mes || row.month || row.Mes || row.Mês || state.month, 10);
                            let rawP = row.porcentagem || row.percentage || row.Porcentagem || row.valor || 0;
                            let p = parseFloat(String(rawP).replace('%', '').replace(',', '.')) || 0;
                            items.push({ day: d, month: m, percentage: p });
                        }
                    });
                } else if (typeof jsonData === 'object' && jsonData !== null) {
                    const list = jsonData.data || jsonData.items || [jsonData];
                    return processAppsScriptData(list);
                }

                return items;
            } catch (e) {
                console.error("Erro ao processar dados do Apps Script:", e);
                return null;
            }
        }

        async function fetchAppsScriptData(url, options = {}) {
            if (!url) return;

            const timeoutMs = options.timeoutMs || 8000;

            syncBadge.classList.remove('hidden');
            syncBadge.classList.add('flex');
            syncStatusText.textContent = historyRecords.length ? "Atualizando..." : "Buscando...";
            syncDot.className = "w-2.5 h-2.5 rounded-full bg-yellow-400 animate-pulse";

            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

            try {
                // Evita reaproveitar uma resposta antiga do navegador/proxy.
                const separator = url.includes('?') ? '&' : '?';
                const requestUrl = `${url}${separator}_ts=${Date.now()}`;

                const response = await fetch(requestUrl, {
                    method: 'GET',
                    redirect: 'follow',
                    cache: 'no-store',
                    signal: controller.signal
                });

                if (!response.ok) throw new Error(`Erro HTTP ${response.status}`);

                const jsonData = await response.json();
                const records = processAppsScriptData(jsonData);

                if (!records || !records.length) {
                    throw new Error("Nenhum dado válido retornado");
                }

                // Guarda a última resposta REAL para a próxima abertura.
                saveLocalCache(records);
                applyRecords(records, "Fonte: Google Apps Script", true);

                syncStatusText.textContent = "Apps Script atualizado";
                syncDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse";

            } catch (err) {
                const reason = err.name === "AbortError"
                    ? `tempo limite de ${timeoutMs / 1000}s`
                    : err.message;

                console.warn(`Atualização do Apps Script não concluída (${reason}).`, err);

                // Se já temos dados reais salvos, mantém esses dados.
                if (historyRecords.length > 0) {
                    syncStatusText.textContent = "Último dado salvo";
                    syncDot.className = "w-2.5 h-2.5 rounded-full bg-cyan-400";
                    document.getElementById('sheetSourceLabel').textContent =
                        "Fonte: Cache local — aguardando atualização";
                } else {
                    // Só usa os dados de demonstração se este navegador nunca
                    // tiver recebido uma resposta válida.
                    historyRecords = [
                        { day: 7, month: 9, percentage: 35.0 },
                        { day: 14, month: 9, percentage: 62.8 },
                        { day: 18, month: 9, percentage: 75.5 },
                        { day: 21, month: 9, percentage: 88.0 },
                        { day: 28, month: 9, percentage: 102.4 }
                    ];

                    applyRecords(historyRecords, "Fonte: Dados de demonstração", false);
                    syncStatusText.textContent = "Modo Histórico Ativo";
                    syncDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400";
                }
            } finally {
                clearTimeout(timeoutId);

                // Mantém o comportamento original de abrir o histórico ao carregar.
                renderHistoryModal();
                historyModal.classList.remove('opacity-0', 'pointer-events-none');
            }
        }

        // Preenche a URL no Modal de Configurações
        scriptUrlInput.value = DEFAULT_APPS_SCRIPT_URL;

        // Event Listeners dos Modais e Botões
        openConfigBtn.addEventListener('click', () => {
            configModal.classList.remove('opacity-0', 'pointer-events-none');
        });

        closeConfigBtn.addEventListener('click', () => {
            configModal.classList.add('opacity-0', 'pointer-events-none');
        });

        openHistoryBtn.addEventListener('click', () => {
            renderHistoryModal();
            historyModal.classList.remove('opacity-0', 'pointer-events-none');
        });

        closeHistoryBtn.addEventListener('click', () => {
            historyModal.classList.add('opacity-0', 'pointer-events-none');
        });

        closeHistoryBottomBtn.addEventListener('click', () => {
            historyModal.classList.add('opacity-0', 'pointer-events-none');
        });

        tabScriptBtn.addEventListener('click', () => {
            tabScriptBtn.className = "py-2 px-4 text-xs font-bold border-b-2 border-ibg-cyan text-ibg-cyan uppercase tracking-wider";
            tabManualBtn.className = "py-2 px-4 text-xs font-bold border-b-2 border-transparent text-slate-400 hover:text-white uppercase tracking-wider";
            tabScriptContent.classList.remove('hidden');
            tabManualContent.classList.add('hidden');
        });

        tabManualBtn.addEventListener('click', () => {
            tabManualBtn.className = "py-2 px-4 text-xs font-bold border-b-2 border-ibg-cyan text-ibg-cyan uppercase tracking-wider";
            tabScriptBtn.className = "py-2 px-4 text-xs font-bold border-b-2 border-transparent text-slate-400 hover:text-white uppercase tracking-wider";
            tabManualContent.classList.remove('hidden');
            tabScriptContent.classList.add('hidden');
        });

        manualPercentInput.addEventListener('input', (e) => {
            manualSliderVal.textContent = `${parseFloat(e.target.value).toLocaleString('pt-BR')}%`;
        });

        applyManualBtn.addEventListener('click', () => {
            state.day = parseInt(manualDayInput.value, 10) || 1;
            state.month = parseInt(manualMonthSelect.value, 10) || 1;
            state.percentage = parseFloat(manualPercentInput.value) || 0;
            
            const existingIdx = historyRecords.findIndex(r => r.day === state.day && r.month === state.month);
            if (existingIdx !== -1) {
                historyRecords[existingIdx].percentage = state.percentage;
            } else {
                historyRecords.push({ day: state.day, month: state.month, percentage: state.percentage });
            }

            updateDashboardUI(true);
            configModal.classList.add('opacity-0', 'pointer-events-none');
            document.getElementById('sheetSourceLabel').textContent = "Fonte: Dados Manuais / Teste";
        });

        fetchScriptBtn.addEventListener('click', () => {
            const url = scriptUrlInput.value.trim();
            if (url) {
                state.scriptUrl = url;
                fetchAppsScriptData(url);
                configModal.classList.add('opacity-0', 'pointer-events-none');
            } else {
                alert("Por favor, insira uma URL válida do Apps Script.");
            }
        });

        // Animação do Canvas de Fundo
        function initCanvasAnimation() {
            const canvas = document.getElementById('circuitCanvas');
            const ctx = canvas.getContext('2d');

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            const nodes = [];
            const nodeCount = Math.floor(window.innerWidth / 35);

            for (let i = 0; i < nodeCount; i++) {
                nodes.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    radius: Math.random() * 2 + 1
                });
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                ctx.strokeStyle = 'rgba(0, 240, 255, 0.08)';
                ctx.lineWidth = 1;

                for (let i = 0; i < nodes.length; i++) {
                    for (let j = i + 1; j < nodes.length; j++) {
                        const dx = nodes[i].x - nodes[j].x;
                        const dy = nodes[i].y - nodes[j].y;
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        if (dist < 140) {
                            ctx.beginPath();
                            ctx.moveTo(nodes[i].x, nodes[i].y);
                            ctx.lineTo(nodes[j].x, nodes[j].y);
                            ctx.stroke();
                        }
                    }
                }

                nodes.forEach(node => {
                    node.x += node.vx;
                    node.y += node.vy;

                    if (node.x < 0 || node.x > canvas.width) node.vx *= -1;
                    if (node.y < 0 || node.y > canvas.height) node.vy *= -1;

                    ctx.fillStyle = '#00f0ff';
                    ctx.beginPath();
                    ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
                    ctx.fill();
                });

                requestAnimationFrame(animate);
            }

            animate();
        }

        // Executado ao abrir a página
        window.onload = function() {
            initCanvasAnimation();

            // Primeiro mostra o último dado salvo, sem esperar a internet.
            const hasCache = showCachedDataIfAvailable();

            // Depois consulta o Apps Script em segundo plano.
            // Se ele demorar, o usuário continua vendo o último dado conhecido.
            fetchAppsScriptData(state.scriptUrl, {
                background: hasCache,
                timeoutMs: 8000
            });
        };

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.error(`Erro ao ativar tela cheia: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }
    </script>
